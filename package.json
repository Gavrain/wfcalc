{
  "name": "wfcalc",
  "private": true,
  "version": "0.1.0",
  "description": "Warframe weapon damage simulator with per-bucket breakdown",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test --test-isolation=none --experimental-strip-types \"packages/*/test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "build:data": "node --experimental-strip-types packages/data-build/src/index.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.1",
    "typescript": "^5.6.0"
  }
}
